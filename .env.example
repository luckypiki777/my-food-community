# 이 파일을 .env.local 로 복사한 뒤 값을 채운다.
#
# 값 위치: Supabase 대시보드 → Project Settings → API Keys
#
# NEXT_PUBLIC_ 접두사를 붙이지 않는다. 붙이는 순간 브라우저 번들에 들어가고,
# CLAUDE.md 의 "모든 Supabase 접근은 BFF를 통한다" 규약이 깨진다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 공개 스토리지 주소. 끝에 버킷명을 붙이지 않는다.
# profile-image / place-image 두 버킷이 이 값을 공유한다.
# BFF가 `<이 값>/<버킷>/<파일경로>` 로 조립해 내려주므로 테이블에는 경로만 저장된다.
# 값: <SUPABASE_URL>/storage/v1/object/public
SUPABASE_STORAGE_URL=

# secret(구 service_role) 키. RLS를 통째로 우회한다.
#
# 쓰는 곳은 **포트원 결제 웹훅(/api/payments/webhook) 하나뿐이다.**
# 웹훅은 포트원 서버가 부르므로 로그인한 사람도 세션 쿠키도 없는데, payment 의 RLS 는
# `auth.uid() = user_id` 라 세션 없이는 결제 행을 넣을 방법이 아예 없다.
# 요청의 진위는 웹훅 서명이, 결제의 진위는 포트원 결제 조회가 대신 판정한다.
#
# **다른 라우트로 이 키를 넓히지 말 것.** 넓히는 순간 RLS가 방어선 역할을 못 한다.
# 값 위치: Supabase 대시보드 → Project Settings → API Keys → Secret keys
# 비워 두면 앱은 그대로 돌아가고 웹훅만 503으로 받지 않는다(포트원이 재전송한다).
SUPABASE_SECRET_KEY=

# ─────────────────────────────────────────────────────────────────────
# 네이버 지도 (장소 선택 화면의 지도 + 핀 위치의 주소 읽기)
#
# 값 위치: NAVER Cloud Platform 콘솔 → Services → Application → Maps
#          → 애플리케이션 등록 후 발급되는 Client ID(= Key ID) / Client Secret(= Key)
#
# 함께 켜야 하는 서비스: Web Dynamic Map (지도),
#                        Reverse Geocoding (핀 위치의 주소 읽기 — 없으면 주소만 빈다)
#
# 두 값은 **같은 애플리케이션의 짝**이다. 쓰이는 곳이 다를 뿐이다:
#   - CLIENT_ID     : 지도 SDK 의 <script src>(ncpKeyId) + 리버스 지오코딩 REST 헤더
#                     (x-ncp-apigw-api-key-id)
#   - CLIENT_SECRET : 리버스 지오코딩 REST 헤더(x-ncp-apigw-api-key) 에만.
#                     이 값은 브라우저로 나가지 않는다. /api/map/reverse-geocode 가
#                     서버에서 대신 부른다.
#
# "Web 서비스 URL" 에 이 앱의 주소를 등록해야 한다. 등록한 도메인과 다른 곳에서 부르면
# 지도가 "인증 실패" 로 뜬다. 로컬 개발은 http://localhost:3000 을 넣는다.
#
# CLIENT_ID 는 지도 SDK 의 <script src> 에 실려 브라우저까지 나간다. 숨겨서 지키는 키가
# 아니라 위 "Web 서비스 URL" 로 도메인을 묶어서 지키는 키다. 그래도 NEXT_PUBLIC_ 은 붙이지
# 않는다 — /api/map/config 가 읽어서 내려주므로 환경변수는 서버 한쪽에만 남고, 키를 바꿔도
# 다시 빌드할 필요가 없다.
#
# CLIENT_ID 를 비워 두면 앱은 그대로 돌아가고 지도 자리에만
# "지도 API 키가 설정되지 않았어요" 가 뜬다.
# CLIENT_SECRET 만 비면 지도는 정상이고 주소 영역에만 "주소를 읽지 못했어요" 가 뜬다.
NAVER_MAP_CLIENT_ID=
NAVER_MAP_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# 네이버 지역 검색 (장소 검색 화면)
#
# 위 지도 키와는 **다른 키다.** 지도는 NCP Maps, 검색은 NAVER API Hub 로 서비스가 나뉘어 있다.
#
# 값 위치: NAVER Cloud Platform 콘솔 → Services → AI·NAVER API → NAVER API Hub
#          → Search(검색) 이용 신청 → 발급되는 Client ID / Client Secret
#
# 호출 주소: https://naverapihub.apigw.ntruss.com/search/v1/local
# 헤더:      X-NCP-APIGW-API-KEY-ID (Client ID) / X-NCP-APIGW-API-KEY (Client Secret)
# 문서:      https://api.ncloud-docs.com/docs/naver-api-hub-search-local
#
# 지도 키와 달리 이 값은 브라우저로 나가지 않는다. Secret 이 필요한 API 라 나갈 수도 없다 —
# /api/places/search 가 서버에서 대신 부른다. NEXT_PUBLIC_ 을 붙이지 말 것.
#
# 하루 25,000건 제한이 있다. 그래서 검색 라우트에 로그인 게이트를 두고, 화면은 타이핑이
# 멎은 뒤에야(디바운스) 호출한다.
#
# 비워 두면 앱은 그대로 돌아가고 검색 화면에만 "장소 검색이 아직 설정되지 않았어요" 가 뜬다.
# 지도는 위 키만 있으면 정상이므로 위치는 지도를 끌어서 고를 수 있다.
NAVER_SEARCH_CLIENT_ID=
NAVER_SEARCH_CLIENT_SECRET=

# ─────────────────────────────────────────────────────────────────────
# 포트원 V2 결제 (강연·모임 배너 상세의 "결제하기")
#
# 규칙의 원본은 rules/payment.md 다. 값을 바꾸기 전에 그 문서를 먼저 읽는다.
#
# 값 위치: 포트원 관리자 콘솔 → 결제 연동
#   STORE_ID    : "상점 아이디" (store-로 시작)
#   CHANNEL_KEY : 연동 정보 → 채널 목록에서 쓸 채널의 "채널 키" (channel-key-로 시작)
#   API_SECRET  : 결제 연동 → V2 API Secret ("발급" 버튼을 눌러야 나온다)
#
# 셋의 쓰임이 다르다:
#   STORE_ID / CHANNEL_KEY
#     결제창을 여는 값이라 결국 브라우저까지 나간다. 그래도 NEXT_PUBLIC_ 을 붙이지 않고
#     /api/payments/config 가 읽어서 내려준다 — 지도 키와 같은 이유로, 환경변수를 서버
#     한쪽에만 두면 키를 바꿔도 다시 빌드할 필요가 없다.
#   API_SECRET
#     **절대 브라우저로 나가지 않는다.** 이 값 하나로 결제 조회·취소가 다 되므로
#     노출되면 남의 결제를 취소할 수 있다. /api/payments/complete 가 서버에서만 쓴다.
#     설정 파일이 아니라 배포 환경의 시크릿으로 넣는다.
#
# 셋 중 하나라도 비면 앱은 그대로 돌아가고 배너 상세의 결제 버튼만 "결제 준비 중" 으로
# 잠긴다. API_SECRET 까지 보는 이유가 중요하다 — 그 값은 결제창을 여는 데는 쓰이지
# 않아서, 없어도 결제창은 멀쩡히 뜨고 **카드 승인까지 난다.** 그러고 나서 완료 처리만
# 503 으로 막혀, 돈은 나갔는데 우리 DB 엔 아무 기록도 없는 상태가 된다.
# 그래서 /api/payments/config 가 셋을 다 확인하고서야 결제를 시작하게 한다.
PORTONE_STORE_ID=
PORTONE_CHANNEL_KEY=
PORTONE_API_SECRET=

# ─────────────────────────────────────────────────────────────────────
# 포트원 결제 웹훅 (POST /api/payments/webhook)
#
# 위 세 값과 **다른 값이고 쓰임도 다르다.** 위 셋이 "결제를 시작하고 확인하는" 값이라면
# 이건 "포트원이 우리를 부를 때 진짜 포트원인지 확인하는" 값이다. 그래서 섹션을 나눈다.
#
# 값 위치: 포트원 관리자 콘솔 → 결제 연동 → 연동 관리 → [결제알림(Webhook) 관리]
#          → 웹훅 버전 [결제모듈 V2] → 설정 모드(실연동/테스트) → [웹훅 시크릿 발급]
#          같은 화면의 Endpoint URL 에 https://<이 앱 주소>/api/payments/webhook 을 넣는다.
#
# 웹훅 주소는 공개된 URL이라 누구나 두드릴 수 있다. 이 시크릿으로 서명
# (Standard Webhooks · webhook-id / webhook-timestamp / webhook-signature 헤더)을
# 검증하지 않으면 아무나 "결제 완료" 를 만들어 넣을 수 있다.
# **절대 브라우저로 나가지 않는다.** 서명 검증은 서버에서만 한다.
#
# 시크릿은 환경별(실연동/테스트)로, 또 무중단 교체를 위해 한 환경에 최대 2개까지
# 발급된다. 교체할 때는 새 값을 먼저 넣고 배포한 뒤 콘솔에서 옛 값을 만료시킨다.
#
# 비워 두면 결제는 그대로 되고 웹훅만 503으로 받지 않는다. 그러면 결제창이 닫히다 만 건
# (브라우저 종료·네트워크 끊김)을 확정하지 못하므로 운영에서는 사실상 필수다.
# 채워 넣으면 그 사이 밀린 건이 포트원 재전송(최대 5회)으로 따라 들어온다.
PORTONE_WEBHOOK_SECRET=
