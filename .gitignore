# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
# 실제 키는 .env.local 에만 있다. 껍데기인 .env.example 만 올린다.
.env*
!.env.example

# 에이전트 · 로컬 툴링 설정 (개인 환경. 저장소에 올리지 않는다)
# .mcp.json 에는 Supabase 프로젝트 ref 가 박혀 있다.
.mcp.json
.claude/
.agents/
skills-lock.json

# 디자인 참고용으로 뽑아둔 이미지 (앱이 참조하지 않는다)
/images/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

*storybook.log
storybook-static

# font source artifacts (woff2 lives in public/fonts)
/Pretendard-1.3.9.zip
/Pretendard-1.3.9/
